# ============================================================
# .env.example — FILE MẪU (được phép commit lên GitHub)
# Copy thành `.env.local` để chạy local, hoặc dùng giá trị này
# để điền vào Settings của Vercel / Netlify / Render khi deploy.
#
#   VD local:  cp .env.example .env.local
#   VD deploy: chèn API_URL = https://<api-cua-ban>.onrender.com
#              vào phần Environment Variables của nền tảng.
# ============================================================
API_URL=https://<api-cua-ban>.onrender.com
